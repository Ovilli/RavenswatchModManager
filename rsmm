#!/usr/bin/env python3
"""rsmm — single CLI for Ravenswatch mod install + lifecycle.

The top-level command listing is NOT written here. It is rendered by
`rsmm.cli._dispatch.render_help()` from the routing table itself, because a
hand-maintained copy drifted: 23 of the 44 routed commands had fallen out of
it and were undiscoverable. Add a subcommand to `_dispatch` and it shows up.
"""

from __future__ import annotations
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent
sys.path.insert(0, str(ROOT / "src"))

from rsmm.cli import _dispatch as _dispatch_mod  # noqa: E402

if __name__ == "__main__":
    sys.exit(_dispatch_mod.main(sys.argv[1:]))
