{
  "name": "rsmm-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Ravenswatch Mod Manager \u2014 cross-platform GUI (browser + Tauri desktop) + Neon-backed registry.",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "turbo run dev --filter=desktop",
    "desktop:dev": "turbo run dev --filter=desktop",
    "api:dev": "turbo run dev --filter=api",
    "www:dev": "turbo run dev --filter=www",
    "docs:dev": "turbo run dev --filter=docs",
    "build": "turbo run build",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "check-types": "turbo run check-types",
    "audit:supply-chain": "node scripts/audit-supply-chain.mjs",
    "db:push": "pnpm --filter @rsmm/db push",
    "db:seed": "pnpm --filter @rsmm/db seed",
    "db:seed:guides": "pnpm --filter @rsmm/db seed:guides",
    "db:migrate": "pnpm --filter @rsmm/db migrate",
    "generate": "pnpm --filter @rsmm/db generate",
    "db:studio": "pnpm --filter @rsmm/db studio",
    "test": "turbo run test",
    "test:python": "python -m pytest -n auto",
    "test:python:fast": "python -m pytest -n auto -m \"not slow\"",
    "test:ts": "turbo run test --filter=@rsmm/schemas --filter=@rsmm/api-client --filter=desktop --filter=www",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "clean": "turbo run clean && rm -rf node_modules .turbo"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "next": "15.5.24",
    "turbo": "2.9.14",
    "typescript": "5.7.3"
  },
  "pnpm": {
    "overrides": {
      "fast-xml-parser": ">=5.3.5",
      "smol-toml": ">=1.7.1",
      "baseline-browser-mapping": ">=2.11.0",
      "sharp": ">=0.35.4",
      "fast-uri": "^3.1.6",
      "js-yaml@3": "^3.15.2",
      "js-yaml@4": "^4.3.2",
      "postcss@8": "^8.5.18",
      "browserslist": ">=4.28.7"
    }
  }
}
