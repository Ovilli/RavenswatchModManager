{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "ghidra": {
      "type": "local",
      "enabled": true,
      "command": [
        "uv",
        "run",
        "--script",
        "tools/ghidra_mcp/bridge_mcp_ghidra.py",
        "--ghidra-server",
        "http://127.0.0.1:8080/",
        "--transport",
        "stdio"
      ]
    }
  }
}