bin/
obj/
grid/data/
grid/tmp/
grid/packages/
# Any level: the CLI also builds a grid into .stormancer/ in whatever directory it is run from,
# which is ~100MB of build output.
.stormancer/
grid/logs/
grid/*.log
.tools/

# The CLI writes a bootstrapper config into whatever directory it is run from; the
# one that matters is grid/bootstrapper.config.json, which is tracked.
/bootstrapper.config.json
