{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for desktop app",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-minimize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-close",
    "core:window:allow-is-maximized",
    "core:window:allow-is-minimized",
    "core:window:allow-is-decorated",
    "core:webview:default",
    "core:event:default",
    {
      "identifier": "shell:allow-open",
      "allow": [
        { "url": "https://github.com/Ovilli/RavenswatchModManager/**" },
        { "url": "https://api.rsmm.me/**" },
        { "url": "file:///**" }
      ]
    },
    {
      "identifier": "shell:allow-execute",
      "allow": [
        { "name": "binaries/rsmm", "sidecar": true, "args": true },
        { "name": "run-rsmm", "cmd": "rsmm", "args": true },
        { "name": "mkdir", "cmd": "mkdir", "args": true },
        { "name": "pgrep", "cmd": "pgrep", "args": [
          { "validator": "^-f$" },
          { "validator": "^Ravenswatch(\\.exe)?$" }
        ] },
        { "name": "tasklist", "cmd": "tasklist", "args": [
          { "validator": "^/FI$" },
          { "validator": "^IMAGENAME eq Ravenswatch\\.exe$" },
          { "validator": "^/NH$" }
        ] }
      ]
    },
    "deep-link:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://api.rsmm.me/**" },
        { "url": "https://accounts.google.com/**" },
        { "url": "https://github.com/**" },
        { "url": "http://localhost:*/**" }
      ]
    },
    "updater:default",
    "process:default",
    "os:default"
  ]
}
