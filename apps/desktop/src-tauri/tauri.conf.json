{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ravenswatch Mod Manager",
  "version": "0.4.1",
  "identifier": "dev.rsmm.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev:vite",
    "beforeBuildCommand": "pnpm build:vite"
  },
  "app": {
    "windows": [
      {
        "title": "Ravenswatch Mod Manager",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "decorations": false,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; connect-src 'self' https://api.rsmm.me https://rsmm.me; img-src 'self' data: https://api.rsmm.me https://s3-rsmm.me https://cdn.rsmm.me; font-src 'self' https://fonts.gstatic.com; frame-src https://rsmm.me https://www.youtube.com https://www.youtube-nocookie.com https://player.vimeo.com; object-src 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["appimage", "deb", "nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico", "icons/icon.icns"],
    "category": "Utility",
    "shortDescription": "Mod manager for Ravenswatch (Windows + Linux).",
    "longDescription": "A mod manager for Ravenswatch on Windows and Linux. Browse, install, and manage mods through a graphical interface. Swap textures, edit stats, override translations, and author Lua-scripted mods.",
    "externalBin": ["binaries/rsmm"],
    "windows": {},
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libjavascriptcoregtk-4.1-0",
          "libsoup-3.0-0",
          "glib-networking",
          "gsettings-desktop-schemas"
        ]
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  },
  "plugins": {
    "shell": {
      "open": "^((mailto:\\w+)|(tel:\\w+)|(https?://\\w+)|(file:///\\w+)).+"
    },
    "updater": {
      "active": true,
      "dialog": false,
      "endpoints": [
        "https://github.com/Ovilli/RavenswatchModManager/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMyRkY5REY5NTNBMEU5NjYKUldSbTZhQlQrWjMvd3BpL3lzMENUcHJzUkFGdnpHK3pzWWRkSlVIemxxYWsvS3J2d3k0QW1lVEcK"
    }
  }
}
