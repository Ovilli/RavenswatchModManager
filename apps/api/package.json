{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "vercel-build": "tsup && rm -rf src dist tsconfig.json tsconfig.tsbuildinfo tsup.config.ts",
    "start": "node dist/index.js",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist .turbo api/*.js api/*.js.map"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1051.0",
    "@aws-sdk/s3-request-presigner": "3.1051.0",
    "@hono/node-server": "1.19.15",
    "@hono/zod-validator": "0.4.2",
    "@neondatabase/serverless": "0.10.4",
    "@rsmm/db": "workspace:*",
    "@rsmm/schemas": "workspace:*",
    "better-auth": "1.6.22",
    "dotenv": "16.4.7",
    "drizzle-orm": "0.45.2",
    "hono": "4.12.34",
    "nodemailer": "^9.0.1",
    "pg": "8.13.1",
    "ws": "8.21.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@rsmm/tsconfig": "workspace:*",
    "@types/node": "22.10.5",
    "@types/nodemailer": "^8.0.0",
    "tsup": "^8.5.1",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "3.2.6"
  }
}
