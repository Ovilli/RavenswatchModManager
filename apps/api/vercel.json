{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter api vercel-build",
  "ignoreCommand": "sh ../../scripts/vercel-ignore-build.sh api",
  "git": {
    "deploymentEnabled": {
      "testing": false,
      "dependabot/**": false
    }
  },
  "crons": [
    {
      "path": "/api/cron/scan-drain",
      "schedule": "0 4 * * *"
    }
  ]
}
