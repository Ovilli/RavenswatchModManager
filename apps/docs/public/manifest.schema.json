{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://docs.rsmm.me/manifest.schema.json",
  "title": "RSMM mod manifest",
  "description": "manifest.toml of a Ravenswatch Mod Manager mod. Generated by `rsmm docs-gen` from rsmm.sdk.manifest_spec.",
  "type": "object",
  "properties": {
    "mod": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Mod id — the folder name under mods/."
        },
        "name": {
          "type": "string",
          "description": "Display name."
        },
        "version": {
          "type": "string",
          "description": "Semantic version, e.g. 1.2.0."
        },
        "author": {
          "description": "Who made it."
        },
        "enabled": {
          "type": "boolean",
          "description": "Whether `rsmm apply` installs it."
        },
        "sdk_version": {
          "description": "SDK range this mod was written against, e.g. \">=3.0,<4\"."
        },
        "experimental": {
          "type": "boolean",
          "description": "Opt in to content kinds not yet confirmed in game."
        },
        "summary": {
          "description": "One-line tagline for the store (≤512 chars)."
        },
        "description": {
          "description": "Long description for the store (≤8192 chars)."
        },
        "license": {
          "description": "SPDX id or licence name."
        },
        "repo_url": {
          "description": "Source repository URL."
        },
        "homepage_url": {
          "description": "Homepage URL."
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Store discovery tags (≤16, each ≤32 chars)."
        },
        "game_build": {
          "description": "Game build this mod needs."
        },
        "min_loader": {
          "description": "Oldest loader version this mod works with."
        },
        "load_order": {
          "type": "integer",
          "description": "Lower loads first (default 100); later wins a conflict."
        },
        "priority": {
          "type": "integer",
          "description": "Tie-breaker within one load_order."
        },
        "requires": {
          "description": "Mods that must be installed: [\"other-mod >=1.0\"]."
        },
        "recommends": {
          "description": "Mods worth installing alongside."
        },
        "suggests": {
          "description": "Mods that go well with this one."
        },
        "conflicts": {
          "description": "Mods that must not be enabled with this one."
        },
        "replaces": {
          "description": "Mod ids this one supersedes."
        },
        "multiplayer_scope": {
          "enum": [
            "cosmetic",
            "deterministic-shared",
            "host-authoritative",
            "local-only"
          ],
          "description": "cosmetic | deterministic-shared | host-authoritative | local-only."
        }
      },
      "additionalProperties": false
    },
    "content": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "enum": [
              "animation",
              "boss",
              "enemy",
              "game_mode",
              "hero",
              "item",
              "map",
              "melody",
              "mesh",
              "modifier",
              "poi",
              "reward",
              "shop",
              "skill",
              "talent",
              "tilegen"
            ],
            "description": "Content kind."
          },
          "id": {
            "type": "string",
            "description": "Unique within this mod and kind."
          }
        },
        "required": [
          "kind",
          "id"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "animation"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "properties": {
                "clip": {},
                "id": {},
                "kind": {},
                "schema_version": {},
                "source": {},
                "strict": {},
                "target": {}
              },
              "additionalProperties": false
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "boss"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "properties": {
                "base": {},
                "becomes": {},
                "id": {},
                "kind": {},
                "name": {},
                "schema_version": {}
              },
              "additionalProperties": false
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "enemy"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "properties": {
                "add_flags": {},
                "base": {},
                "casts": {},
                "cross_biome": {},
                "display_name": {},
                "enemies": {},
                "entity": {},
                "exclude": {},
                "flags": {},
                "id": {},
                "imports": {},
                "kind": {},
                "mix": {},
                "mode": {},
                "name": {},
                "pools": {},
                "power": {},
                "repoint_pools": {},
                "schema_version": {},
                "seed": {},
                "tribe": {},
                "weight": {}
              },
              "additionalProperties": false
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "game_mode"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "properties": {
                "base": {},
                "chapters": {},
                "id": {},
                "kind": {},
                "schema_version": {}
              },
              "additionalProperties": false
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "hero"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "properties": {
                "abilities": {},
                "albedo": {},
                "animations": {},
                "base": {},
                "description": {},
                "id": {},
                "kind": {},
                "model": {},
                "mra": {},
                "name": {},
                "normal": {},
                "outfits": {},
                "own_entity": {},
                "portrait": {},
                "references": {},
                "schema_version": {},
                "transform": {},
                "values": {},
                "weapons": {}
              },
              "additionalProperties": false
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "item"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "properties": {
                "base": {},
                "description": {},
                "display_name": {},
                "drop_weight": {},
                "icon": {},
                "id": {},
                "items": {},
                "kind": {},
                "level": {},
                "mode": {},
                "name": {},
                "rarity": {},
                "schema_version": {},
                "tags": {},
                "unique_identity": {},
                "value_patches": {}
              },
              "additionalProperties": false
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "map"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "properties": {
                "base": {},
                "chapter": {},
                "id": {},
                "kind": {},
                "schema_version": {},
                "tribe": {}
              },
              "additionalProperties": false
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "melody"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "properties": {
                "base": {},
                "effect": {},
                "exclude": {},
                "id": {},
                "kind": {},
                "schema_version": {}
              },
              "additionalProperties": false
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "mesh"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "properties": {
                "id": {},
                "kind": {},
                "model": {},
                "schema_version": {},
                "target": {},
                "transform": {}
              },
              "additionalProperties": false
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "modifier"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "properties": {
                "base": {},
                "description": {},
                "effect": {},
                "id": {},
                "kind": {},
                "name": {},
                "schema_version": {}
              },
              "additionalProperties": false
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "poi"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "properties": {
                "base": {},
                "chapters": {},
                "copies": {},
                "icon": {},
                "icon_source": {},
                "id": {},
                "kind": {},
                "kinds": {},
                "own_level": {},
                "places": {},
                "prop": {},
                "replace_base": {},
                "schema_version": {},
                "swaps": {},
                "weight": {}
              },
              "additionalProperties": false
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "reward"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "properties": {
                "ban": {},
                "base": {},
                "counts": {},
                "id": {},
                "kind": {},
                "schema_version": {}
              },
              "additionalProperties": false
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "shop"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "properties": {
                "config": {},
                "id": {},
                "kind": {},
                "offers": {},
                "price_scale": {},
                "prices": {},
                "schema_version": {},
                "slots": {}
              },
              "additionalProperties": false
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "skill"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "properties": {
                "controller": {},
                "description": {},
                "display_name": {},
                "hero": {},
                "icon": {},
                "id": {},
                "kind": {},
                "mode": {},
                "name": {},
                "schema_version": {},
                "source": {}
              },
              "additionalProperties": false
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "talent"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "properties": {
                "clone_nodes": {},
                "file": {},
                "hero": {},
                "id": {},
                "int_patches": {},
                "kind": {},
                "rewires": {},
                "schema_version": {},
                "union_patches": {},
                "value_patches": {}
              },
              "additionalProperties": false
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "tilegen"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "properties": {
                "chapter": {},
                "fill": {},
                "id": {},
                "kind": {},
                "kinds": {},
                "quotas": {},
                "schema_version": {},
                "slots": {}
              },
              "additionalProperties": false
            }
          }
        ]
      }
    },
    "patch": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "enum": [
              "ot",
              "stat",
              "texture"
            ]
          }
        },
        "required": [
          "kind"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "ot"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "properties": {
                "field": {},
                "file": {},
                "kind": {},
                "selector": {},
                "selector_field": {},
                "value": {}
              },
              "required": [
                "field",
                "selector",
                "value"
              ],
              "additionalProperties": false
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "stat"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "properties": {
                "kind": {},
                "max": {},
                "min": {},
                "name": {},
                "value": {}
              },
              "required": [
                "name"
              ],
              "additionalProperties": false
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "texture"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "properties": {
                "donor": {},
                "kind": {},
                "target": {}
              },
              "required": [
                "donor",
                "target"
              ],
              "additionalProperties": false
            }
          }
        ]
      }
    }
  },
  "required": [
    "mod"
  ]
}
