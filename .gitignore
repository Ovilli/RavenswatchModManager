# Build output
src/loader/build/
src/loader/third_party/*/
!src/loader/third_party/.gitkeep

# mods/ is NOT tracked. Mod folders contain game-derived cooked assets
# (textures, meshes, entity/localization data) that are derivative works
# of the copyrighted game — they must not live in a public repo. Mods are
# user-local content; author them with the SDK, apply from your own install.
# (This replaces the old "tracked example mods" policy for legal reasons.)
mods/

# Packed mods + prebuilt loader DLL.
# winhttp.dll is a build artifact shipped via GitHub Releases, not committed.
dist/*.zip
dist/winhttp.dll

# Extracted uncooked game assets (3.2 GB, regenerable via scripts/extract_uncooked.py)
data/uncooked/

# Pattern DB for rsmm.resolve (20 MB, regenerable via scripts/gen_function_patterns.py)
data/function_patterns.json
# game-derived: mine_fingerprints currently embeds decompiled function bodies
data/symbol_fingerprints.json

# Big RE artifacts — outputs are local
ghidra_project/
data/decompiled.jsonl
data/vftables.jsonl
docs/_re/out/decompiled_all/
docs/_re/out/xref_targets/
docs/_re/out/symbols.json
docs/_re/out/strings.json
docs/_re/out/functions_index.tsv
docs/_re/out/xref_targets_summary.json
docs/_re/project/
docs/_re/project/

